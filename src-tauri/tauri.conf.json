{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "version": "0.2.3",
  "identifier": "app.quotafloat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Glint",
        "width": 52,
        "height": 52,
        "minWidth": 52,
        "minHeight": 52,
        "maxWidth": 288,
        "maxHeight": 288,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "resources": {
      "../src/assets/fonts/InstrumentSerif-OFL.txt": "licenses/InstrumentSerif-OFL.txt",
      "../src/assets/fonts/Manrope-OFL.txt": "licenses/Manrope-OFL.txt",
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE"
    },
    "shortDescription": "Codex quota at a glance",
    "longDescription": "A lightweight floating desktop card for Codex usage limits.",
    "copyright": "Copyright Quota Float contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "15.2"
    }
  }
}
